{
  "name": "pdf-to-markdown-converter",
  "version": "1.0.0",
  "description": "A simple and efficient PDF to Markdown converter with image resizing support (CLI and Web)",
  "main": "dist/index.js",
  "bin": {
    "pdf2md": "dist/cli.js",
    "img-resize": "dist/image-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "dev:image": "ts-node src/image-cli.ts",
    "dev:web": "ts-node src/web-server.ts",
    "start:web": "node dist/web-server.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "pdf",
    "markdown",
    "converter",
    "pdf2md",
    "image",
    "resize",
    "tiff",
    "web",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "pdf-parse": "^1.1.1",
    "commander": "^11.1.0",
    "sharp": "^0.33.0",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/pdf-parse": "^1.1.4",
    "@types/sharp": "^0.32.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2"
  }
}
